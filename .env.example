# Server-only (never prefix with VITE_). Set these in web/.env locally and in Vercel → Environment Variables.
# MongoDB Atlas → Connect → Drivers. In Atlas Network Access allow 0.0.0.0/0 (Vercel has no fixed IPs).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sahara
# Password for /admin. At least 12 characters.
ADMIN_EMAIL=connectwithsahara@study.iitm.ac.in
ADMIN_PASSWORD=change-me-to-something-long
